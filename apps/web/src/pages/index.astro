---
import MainLayout from "../layouts/MainLayout.astro";

interface QuickModule {
  title: string;
  description: string;
  href: string;
  badge: string;
  accent: "primary" | "secondary";
}

const modules: readonly QuickModule[] = [
  {
    title: "Zoonosis y Veterinarias",
    description:
      "Ubica al CEMZOO y clínicas veterinarias cercanas en Sucre con horarios de emergencia 24h y distancia estimada.",
    href: "/mapa",
    badge: "Directorio Geoespacial",
    accent: "secondary",
  },
  {
    title: "Salud, Vacunas y Educación",
    description:
      "Consulta calendarios de vacunación antirrábica, esterilización y guías de tenencia responsable.",
    href: "/campanas",
    badge: "Prevención y Bienestar",
    accent: "secondary",
  },
  {
    title: "Normativa Legal Vigente",
    description:
      "Accede al resumen ciudadano y PDF oficial de la Ley N.° 700/2015, Código Penal y Ley Municipal N.° 252/2022.",
    href: "/normativa",
    badge: "Marco Jurídico",
    accent: "primary",
  },
  {
    title: "Seguimiento de Denuncia",
    description:
      "Verifica el estado de tu trámite usando tu código correlativo (ej. SOS-000458-2026) o descarga tu Documento de Denuncia.",
    href: "/seguimiento",
    badge: "Trazabilidad",
    accent: "primary",
  },
];
---

<MainLayout title="Inicio">
  <section class="mb-8 rounded-xl border border-border bg-bg-surface p-6 shadow-xs lg:p-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <p class="mb-2 inline-flex items-center rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold text-primary">
          Plataforma de Orientación Jurídica y Protección Animal
        </p>
        <h1 class="font-display text-2xl font-bold text-text-primary lg:text-3xl">
          Protege y defiende a los animales en Sucre
        </h1>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary lg:text-base">
          Genera un Documento de Denuncia formal con respaldo en el Código Penal y la Ley N.° 700/2015
          para presentar ante Fiscalía o POFOMA, o localiza atención veterinaria de urgencia.
        </p>
      </div>

      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a
          href="/denunciar"
          class="inline-flex min-h-[48px] items-center justify-center rounded-lg bg-sos px-5 py-3 text-sm font-semibold text-white no-underline transition-opacity hover:opacity-95"
        >
          Denunciar Maltrato o Biocidio (SOS)
        </a>
        <a
          href="/seguimiento"
          class="inline-flex min-h-[48px] items-center justify-center rounded-lg border border-border bg-bg-surface px-5 py-3 text-sm font-semibold text-text-primary no-underline transition-colors hover:bg-bg-canvas"
        >
          Consultar Código
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="services-heading">
    <h2 id="services-heading" class="mb-4 font-display text-xl font-semibold text-text-primary">
      Servicios Ciudadanos Disponibles
    </h2>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        modules.map((item) => (
          <article class="flex flex-col justify-between rounded-xl border border-border bg-bg-surface p-5 shadow-xs">
            <div>
              <span
                class:list={[
                  "inline-block rounded-full px-2.5 py-1 text-xs font-medium",
                  item.accent === "secondary"
                    ? "bg-secondary-soft text-text-primary"
                    : "bg-primary-soft text-primary",
                ]}
              >
                {item.badge}
              </span>
              <h3 class="mt-3 font-display text-lg font-semibold text-text-primary">
                {item.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">
                {item.description}
              </p>
            </div>

            <div class="mt-4">
              <a
                href={item.href}
                class="inline-flex min-h-[44px] items-center text-sm font-semibold text-primary no-underline hover:text-primary-hover"
              >
                Ir a {item.title} →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</MainLayout>
