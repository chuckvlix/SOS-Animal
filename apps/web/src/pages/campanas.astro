---
import MainLayout from "../layouts/MainLayout.astro";

const vaccinationGuides = [
  {
    title: "Cartilla de vacunación canina",
    description: "Calendario de vacunas y controles para perros.",
    image: "/docs/campanas/cartilla-vacunacion-canina.jpeg",
    pdf: "/docs/campanas/cartilla-vacunacion-canina.pdf",
    alt: "Cartilla de vacunación canina con espacios para registrar vacunas y controles.",
    width: 1152,
    height: 768,
  },
  {
    title: "Cartilla de vacunación felina",
    description: "Calendario de vacunas y controles para gatos.",
    image: "/docs/campanas/cartilla-vacunacion-felina.png",
    pdf: "/docs/campanas/cartilla-vacunacion-felina.pdf",
    alt: "Cartilla de vacunación felina con espacios para registrar vacunas y controles.",
    width: 1024,
    height: 768,
  },
  {
    title: "Cartilla de vacunación para mascotas",
    description: "Registro de vacunas y próximas fechas para perros y gatos.",
    image: "/docs/campanas/cartilla-vacunacion-mascotas.png",
    pdf: "/docs/campanas/cartilla-vacunacion-mascotas.pdf",
    alt: "Cartilla de vacunación con calendarios para un gato y un perro.",
    width: 1152,
    height: 768,
  },
] as const;
---

<MainLayout
  title="Salud y campañas"
  description="Información y cartillas descargables sobre vacunación, esterilización y jornadas antirrábicas para perros y gatos."
>
  <div class="space-y-8">
    <header class="space-y-4 rounded-3xl border border-primary-soft bg-primary-soft/40 p-6 sm:p-8 lg:p-10">
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-primary">Cuidado preventivo</p>
      <h1 class="m-0 font-display text-2xl font-bold leading-tight text-text-primary sm:text-3xl">
        Vacunación y esterilización
      </h1>
      <p class="m-0 max-w-3xl text-sm leading-relaxed text-text-secondary sm:text-base">
        Vacunar y esterilizar a tu mascota previene enfermedades, evita camadas no deseadas y ayuda a reducir el abandono.
      </p>
    </header>

    <section aria-labelledby="vaccination-importance" class="space-y-4">
      <div>
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-secondary-text">Protección y bienestar</p>
        <h2 id="vaccination-importance" class="mt-1 font-display text-xl font-bold text-text-primary sm:text-2xl">
          La importancia de la vacunación
        </h2>
      </div>

      <article class="grid overflow-hidden rounded-3xl border border-border bg-bg-surface shadow-xs md:grid-cols-2">
        <img
          src="/docs/campanas/importancia-vacunacion.jpeg"
          alt="Cartilla informativa sobre la importancia de vacunar a perros y gatos."
          width="1152"
          height="768"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] h-full w-full bg-bg-canvas object-contain"
        />
        <div class="flex flex-col items-start justify-center gap-4 p-5 sm:p-7">
          <div>
            <h3 class="font-display text-lg font-semibold text-text-primary">¿Por qué es importante vacunar?</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">
              Conoce cómo las vacunas ayudan a prevenir enfermedades y qué cuidados acompañan cada etapa.
            </p>
          </div>
          <a
            href="/docs/campanas/importancia-vacunacion.pdf"
            download
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
          >
            Descargar cartilla PDF
          </a>
        </div>
      </article>
    </section>

    <section aria-labelledby="vaccination-schedule" class="space-y-4">
      <div>
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-secondary-text">Guías por especie y edad</p>
        <h2 id="vaccination-schedule" class="mt-1 font-display text-xl font-bold text-text-primary sm:text-2xl">
          1. Esquema de Vacunación por Edades
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-text-secondary sm:text-base">
          Las vacunas que necesita tu perro o gato cambian según su edad. Aquí encontrarás los carnets de vacunación con las dosis y refuerzos recomendados en cada etapa.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          vaccinationGuides.map((guide) => (
            <article class="overflow-hidden rounded-2xl border border-border bg-bg-surface shadow-xs">
              <img
                src={guide.image}
                alt={guide.alt}
                width={guide.width}
                height={guide.height}
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full bg-bg-canvas object-contain"
              />
              <div class="flex h-full flex-col items-start gap-3 p-5">
                <div>
                  <h3 class="font-display text-lg font-semibold text-text-primary">{guide.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-text-secondary">{guide.description}</p>
                </div>
                <a
                  href={guide.pdf}
                  download
                  class="mt-auto inline-flex min-h-11 items-center justify-center rounded-xl border border-primary px-4 py-2.5 text-sm font-semibold text-primary no-underline transition-colors hover:bg-primary-soft"
                >
                  Descargar cartilla PDF
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="sterilization" class="space-y-4">
      <div>
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-secondary-text">Salud y comunidad</p>
        <h2 id="sterilization" class="mt-1 font-display text-xl font-bold text-text-primary sm:text-2xl">
          2. La Importancia de la Esterilización
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-text-secondary sm:text-base">
          Esterilizar a tu mascota es una de las mejores decisiones para su salud y para la comunidad: evita camadas no deseadas, reduce peleas y escapes, previene ciertas enfermedades y ayuda a disminuir el abandono.
        </p>
      </div>

      <article class="grid overflow-hidden rounded-3xl border border-border bg-bg-surface shadow-xs md:grid-cols-2">
        <img
          src="/docs/campanas/cartilla-esterilizacion.jpeg"
          alt="Cartilla informativa sobre la esterilización de perros y gatos."
          width="1152"
          height="768"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] h-full w-full bg-bg-canvas object-contain"
        />
        <div class="flex flex-col items-start justify-center gap-4 p-5 sm:p-7">
          <div>
            <h3 class="font-display text-lg font-semibold text-text-primary">Esterilización de perros y gatos</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">
              Revisa los beneficios y cuidados recomendados, y consulta con un profesional veterinario para cada caso.
            </p>
          </div>
          <a
            href="/docs/campanas/cartilla-esterilizacion.pdf"
            download
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
          >
            Descargar cartilla PDF
          </a>
        </div>
      </article>
    </section>

    <section
      aria-labelledby="rabies-campaign"
      class="space-y-3 rounded-3xl border border-border bg-bg-surface p-6 shadow-xs sm:p-8"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-secondary-text">Información nacional</p>
        <span role="status" class="inline-flex items-center rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold text-primary">
          Fecha por confirmar
        </span>
      </div>
      <h2 id="rabies-campaign" class="font-display text-xl font-bold text-text-primary sm:text-2xl">
        Tarjeta 3: Jornada de Vacunación Antirrábica
      </h2>
      <p class="m-0 max-w-3xl text-sm leading-relaxed text-text-secondary sm:text-base">
        Cada año se realiza a nivel nacional una jornada de vacunación, principalmente antirrábica. La fecha aún está por confirmarse. Esta sección se actualizará apenas se conozcan las fechas y los centros de vacunación.
      </p>
    </section>
  </div>
</MainLayout>
