---
import { MOBILE_NAV_ITEMS, isActiveRoute } from "../../data/navigation";
import type { NavItem } from "../../types/ui";
import Icon from "../ui/Icon.astro";

interface Props {
  currentPath: string;
  items?: readonly NavItem[];
}

const { currentPath, items = MOBILE_NAV_ITEMS } = Astro.props;
---

<nav
  aria-label="Acceso rápido móvil"
  class="mobile-bottom-safe fixed inset-x-0 bottom-0 z-30 border-t border-border bg-bg-surface pt-1 lg:hidden"
>
  <ul class="m-0 grid list-none grid-cols-5 items-end gap-1 p-0">
    {
      items.map((item) => {
        const active = isActiveRoute(currentPath, item.href);
        return (
          <li class="flex justify-center">
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex min-h-[48px] min-w-[48px] flex-col items-center justify-center text-xs no-underline transition-colors",
                item.isSos
                  ? [
                      "-mt-3 rounded-xl border-2 bg-sos px-3 py-2 font-semibold text-white shadow-sm",
                      active ? "border-white ring-2 ring-sos-text" : "border-transparent",
                    ]
                  : active
                    ? "rounded-b-lg border-t-2 border-primary bg-primary-soft px-2 py-1 font-semibold text-primary"
                    : "rounded-b-lg border-t-2 border-transparent px-2 py-1 font-medium text-text-secondary hover:text-text-primary",
              ]}
            >
              <Icon name={item.icon} class="h-5 w-5" />
              <span class="mt-0.5 leading-none">{item.mobileLabel}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
