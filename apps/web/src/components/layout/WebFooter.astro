---
import {
  BRAND_NAME,
  FOOTER_LINK_GROUPS,
  JURISDICTION_LABEL,
  REFERENCE_INSTITUTIONS,
} from "../../data/navigation";
import BrandLockup from "../brand/BrandLockup.astro";
import JurisdictionBadge from "../ui/JurisdictionBadge.astro";
---

<footer class="hidden border-t border-border bg-bg-surface lg:block">
  <div class="mx-auto max-w-6xl px-6 py-10 xl:px-8">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <BrandLockup size="md" showSubtitle />
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-text-secondary">
          Plataforma ciudadana gratuita de orientación jurídica, atención veterinaria y denuncia
          contra el maltrato y biocidio animal en {JURISDICTION_LABEL}.
        </p>
        <JurisdictionBadge size="md" class="mt-4" />
      </div>

      {
        FOOTER_LINK_GROUPS.map((group) => (
          <div class="lg:col-span-3">
            <h2 class="m-0 font-display text-sm font-semibold text-text-primary">
              {group.title}
            </h2>
            <ul class="m-0 mt-3 flex list-none flex-col gap-2 p-0">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-[24px] items-center text-sm text-text-secondary no-underline transition-colors hover:text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="lg:col-span-2">
        <h2 class="m-0 font-display text-sm font-semibold text-text-primary">
          Derivación Legal
        </h2>
        <ul class="m-0 mt-3 flex list-none flex-col gap-2 p-0 text-xs leading-relaxed text-text-secondary">
          {REFERENCE_INSTITUTIONS.map((institution) => <li>{institution}</li>)}
        </ul>
      </div>
    </div>

    <div
      class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-xs text-text-secondary"
    >
      <p class="m-0">
        © 2026 {BRAND_NAME} — {JURISDICTION_LABEL}. Plataforma pública de protección animal.
      </p>
    </div>
  </div>
</footer>
