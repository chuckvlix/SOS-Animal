---
import { ABOUT_MISSION_CONTENT } from "../../data/landing";
import type { AboutMissionContent } from "../../types/ui";
import BrandLogo from "../brand/BrandLogo.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  content?: AboutMissionContent;
}

const { content = ABOUT_MISSION_CONTENT } = Astro.props;
---

<section class="mt-12 rounded-3xl border border-border bg-bg-surface p-6 shadow-xs sm:p-8 lg:p-10">
  <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-5">
      <div class="relative mx-auto max-w-md p-3">
        <div
          aria-hidden="true"
          class="absolute -left-1 top-6 h-24 w-24 rounded-full bg-secondary-soft"
        >
        </div>
        <div
          aria-hidden="true"
          class="absolute -right-1 bottom-4 h-28 w-28 rounded-full bg-primary-soft"
        >
        </div>

        <div class="relative overflow-hidden rounded-[2rem] border-4 border-bg-surface bg-bg-canvas shadow-sm">
          <img
            src={content.image.src}
            srcset={content.image.srcSet}
            sizes={content.image.sizes}
            alt={content.image.alt}
            width={content.image.width}
            height={content.image.height}
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover"
          />
        </div>

        <div
          aria-hidden="true"
          class="absolute bottom-0 left-6 inline-flex items-center gap-2 rounded-full border border-border bg-bg-surface px-3 py-1.5 shadow-xs"
        >
          <BrandLogo class="h-5 w-5 text-primary" />
          <span class="font-display text-xs font-semibold text-text-primary">Sucre, Bolivia</span>
        </div>
      </div>
    </div>

    <div class="min-w-0 lg:col-span-7">
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-secondary-text">
        {content.eyebrow}
      </p>

      <h2 class="mt-2 font-display text-2xl font-bold leading-snug text-text-primary lg:text-3xl">
        {content.titleStart}{" "}
        <span class="text-primary">{content.titleHighlight}</span>
      </h2>

      <p class="mt-3 text-sm leading-relaxed text-text-secondary sm:text-base">
        {content.description}
      </p>

      <ul class="m-0 mt-5 grid list-none gap-3 p-0 sm:grid-cols-2">
        {
          content.points.map((point) => (
            <li class="flex min-w-0 items-start gap-2.5 text-sm text-text-primary">
              <span
                aria-hidden="true"
                class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-secondary-soft text-secondary-text"
              >
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-6">
        <a
          href={content.cta.href}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
        >
          <Icon name="legal" class="h-4 w-4" />
          <span>{content.cta.label}</span>
        </a>
      </div>
    </div>
  </div>
</section>
