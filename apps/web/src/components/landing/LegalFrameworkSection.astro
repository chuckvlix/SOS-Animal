---
import { LEGAL_NORM_HIGHLIGHTS } from "../../data/landing";
import { REFERENCE_INSTITUTIONS } from "../../data/navigation";
import type { LegalNormHighlight } from "../../types/ui";
import Icon from "../ui/Icon.astro";

interface Props {
  norms?: readonly LegalNormHighlight[];
  institutions?: readonly string[];
}

const {
  norms = LEGAL_NORM_HIGHLIGHTS,
  institutions = REFERENCE_INSTITUTIONS,
} = Astro.props;
---

<section class="mt-10 grid gap-5 lg:grid-cols-12">
  <div class="min-w-0 rounded-2xl border border-border bg-bg-surface p-5 shadow-xs sm:p-6 lg:col-span-7">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-primary">
          Marco jurídico vigente
        </p>
        <h2 class="mt-1 font-display text-xl font-semibold text-text-primary">
          Leyes que respaldan cada denuncia
        </h2>
      </div>
      <span
        aria-hidden="true"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary"
      >
        <Icon name="legal" class="h-5 w-5" />
      </span>
    </div>

    <ul class="m-0 mt-5 flex list-none flex-col gap-3 p-0">
      {
        norms.map((norm) => (
          <li class="rounded-xl border border-border bg-bg-canvas p-4">
            <p class="m-0 text-xs font-semibold text-primary">{norm.code}</p>
            <h3 class="mt-1 font-display text-base font-semibold text-text-primary">
              {norm.title}
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-text-secondary">{norm.summary}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-5">
      <a
        href="/derechos"
        class="inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold text-primary no-underline hover:text-primary-hover"
      >
        <span>Explorar biblioteca normativa y PDFs</span>
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>

  <div
    class="flex min-w-0 flex-col justify-between rounded-2xl border border-border bg-primary-soft p-5 sm:p-6 lg:col-span-5"
  >
    <div>
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-primary">
        Derivación y trazabilidad
      </p>
      <h2 class="mt-1 font-display text-xl font-semibold text-text-primary">
        Instituciones receptoras en Sucre
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary">
        Cada Documento de Denuncia emitido por la plataforma incluye el sustento legal para su
        presentación ante las entidades competentes:
      </p>

      <ul class="m-0 mt-4 flex list-none flex-col gap-2.5 p-0">
        {
          institutions.map((institution) => (
            <li class="flex items-center gap-2.5 rounded-lg border border-border bg-bg-surface px-3.5 py-2.5 text-sm font-medium text-text-primary">
              <span class="text-secondary">
                <Icon name="check" class="h-4 w-4" />
              </span>
              <span>{institution}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-6 rounded-xl border border-border bg-bg-surface p-4">
      <p class="m-0 text-xs font-semibold text-text-secondary">Documento listo para presentar</p>
      <p class="mt-1 text-sm text-text-primary">
        Emite tu Documento de Denuncia en PDF con código correlativo
        (<span class="tabular-nums font-semibold">SOS-XXXXXX-2026</span>) y Anexo Fotográfico integrado.
      </p>
      <a
        href="/denunciar"
        class="mt-3 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
      >
        Generar Documento de Denuncia
      </a>
    </div>
  </div>
</section>
