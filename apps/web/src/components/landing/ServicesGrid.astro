---
import { CITIZEN_SERVICES } from "../../data/landing";
import type { CitizenService } from "../../types/ui";
import ServiceCard from "./ServiceCard.astro";

interface Props {
  services?: readonly CitizenService[];
  heading?: string;
}

const {
  services = CITIZEN_SERVICES,
  heading = "Servicios Ciudadanos Disponibles",
} = Astro.props;
---

{
  services.length > 0 && (
    <section>
      <h2 class="mb-4 font-display text-xl font-semibold text-text-primary">
        {heading}
      </h2>

      <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2">
        {services.map((service) => (
          <li class="flex">
            <ServiceCard service={service} class="w-full" />
          </li>
        ))}
      </ul>
    </section>
  )
}
