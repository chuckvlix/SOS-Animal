---
import type { CitizenService } from "../../types/ui";
import Icon from "../ui/Icon.astro";

interface Props {
  service: CitizenService;
  class?: string;
}

const { service, class: className } = Astro.props;
const isSecondary = service.accent === "secondary";
---

<article
  class:list={[
    "flex flex-col rounded-xl border border-border bg-bg-surface p-5 shadow-xs lg:p-6",
    className,
  ]}
>
  <header>
    <div class="flex items-center justify-between gap-3">
      <span
        class:list={[
          "inline-block rounded-full px-2.5 py-1 text-xs font-medium",
          isSecondary
            ? "bg-secondary-soft text-text-primary"
            : "bg-primary-soft text-primary",
        ]}
      >
        {service.badge}
      </span>

      <span
        aria-hidden="true"
        class:list={[
          "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg",
          isSecondary
            ? "bg-secondary-soft text-secondary"
            : "bg-primary-soft text-primary",
        ]}
      >
        <Icon name={service.icon} class="h-4 w-4" />
      </span>
    </div>

    <h3 class="mt-3 font-display text-lg font-semibold text-text-primary">
      {service.title}
    </h3>
  </header>

  <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">
    {service.description}
  </p>

  <footer class="mt-auto pt-4">
    <a
      href={service.href}
      class="inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold text-primary no-underline hover:text-primary-hover"
    >
      <span>Ir a {service.title}</span>
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </footer>
</article>
