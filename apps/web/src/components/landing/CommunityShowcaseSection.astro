---
import { COMMUNITY_HIGHLIGHTS } from "../../data/landing";
import type { CommunityHighlight } from "../../types/ui";
import Icon from "../ui/Icon.astro";

interface Props {
  items?: readonly CommunityHighlight[];
  heading?: string;
}

const {
  items = COMMUNITY_HIGHLIGHTS,
  heading = "Servicios ciudadanos y prevención",
} = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-12">
      <div class="mx-auto mb-6 max-w-2xl text-center">
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-secondary-text">
          Información pública para toda la comunidad
        </p>
        <h2 class="mt-1.5 font-display text-2xl font-bold text-text-primary lg:text-3xl">
          {heading}
        </h2>
      </div>

      <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-3">
        {
          items.map((item) => {
            const isSecondary = item.accent === "secondary";
            return (
              <li class="flex min-w-0">
                <article class="flex w-full flex-col rounded-2xl border border-border bg-bg-surface shadow-xs transition-shadow hover:shadow-sm">
                  <div class="overflow-hidden rounded-t-2xl bg-bg-canvas">
                    <img
                      src={item.image.src}
                      alt={item.image.alt}
                      width={item.image.width}
                      height={item.image.height}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[16/10] w-full object-cover"
                    />
                  </div>

                  <div class="flex flex-1 flex-col p-5">
                    <span
                      class:list={[
                        "inline-block self-start rounded-full px-3 py-1 text-xs font-medium",
                        isSecondary
                          ? "bg-secondary-soft text-text-primary"
                          : "bg-primary-soft text-primary",
                      ]}
                    >
                      {item.category}
                    </span>

                    <h3 class="mt-3 font-display text-lg font-semibold text-text-primary">
                      {item.title}
                    </h3>

                    <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">
                      {item.description}
                    </p>

                    <div class="mt-auto pt-4">
                      <a
                        href={item.href}
                        class="inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold text-primary no-underline hover:text-primary-hover"
                      >
                        <span>{item.ctaLabel}</span>
                        <Icon name="arrow-right" class="h-4 w-4" />
                      </a>
                    </div>
                  </div>
                </article>
              </li>
            );
          })
        }
      </ul>
    </section>
  )
}
