---
import { COMPLAINT_PROCESS_STEPS } from "../../data/landing";
import type { AccentTone, ProcessStep } from "../../types/ui";
import Icon from "../ui/Icon.astro";

interface Props {
  steps?: readonly ProcessStep[];
  heading?: string;
}

const {
  steps = COMPLAINT_PROCESS_STEPS,
  heading = "¿Cómo funciona la Ruta Digital de Denuncia?",
} = Astro.props;

const MEDALLION_STYLES: Record<AccentTone, string> = {
  primary: "bg-primary-soft text-primary",
  secondary: "bg-secondary-soft text-secondary-text",
  sos: "bg-sos-soft text-sos-text",
};
---

{
  steps.length > 0 && (
    <section class="mt-12 rounded-3xl border border-border bg-bg-surface p-6 shadow-xs sm:p-8 lg:p-10">
      <div class="mx-auto max-w-2xl text-center">
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-primary">
          Asistente guiado
        </p>
        <h2 class="mt-1.5 font-display text-2xl font-bold text-text-primary lg:text-3xl">
          {heading}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">
          Prepara una denuncia formal con respaldo jurídico y evidencia organizada.
        </p>
      </div>

      <div class="relative mt-8">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-16 top-10 hidden border-t-2 border-dashed border-border lg:block"
        >
        </div>

        <ol class="relative m-0 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
          {
            steps.map((step) => (
              <li class="flex min-w-0 flex-col items-center text-center">
                <div
                  class:list={[
                    "relative z-10 inline-flex h-20 w-20 items-center justify-center rounded-full border-4 border-bg-surface shadow-xs",
                    MEDALLION_STYLES[step.accent],
                  ]}
                >
                  <Icon name={step.icon} class="h-7 w-7" />
                  <span class="tabular-nums absolute -bottom-1 -right-1 inline-flex h-6 min-w-6 items-center justify-center rounded-full border border-border bg-bg-surface px-1.5 text-[11px] font-bold text-text-primary">
                    {step.stepNumber}
                  </span>
                </div>

                <span class="mt-4 rounded-full bg-bg-canvas px-2.5 py-0.5 text-xs font-medium text-text-secondary">
                  {step.tag}
                </span>

                <h3 class="mt-2 font-display text-base font-semibold text-text-primary">
                  {step.title}
                </h3>

                <p class="mt-1 max-w-xs text-sm leading-relaxed text-text-secondary">
                  {step.description}
                </p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-7 text-center">
        <a
          href="/denunciar"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-sos px-6 py-3 text-sm font-semibold text-white no-underline shadow-xs transition-opacity hover:opacity-95"
        >
          <Icon name="sos" class="h-4 w-4" />
          <span>Iniciar Denuncia SOS</span>
        </a>
      </div>
    </section>
  )
}
