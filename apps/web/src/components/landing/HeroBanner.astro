---
import { HERO_CONTENT } from "../../data/landing";
import type { HeroContent } from "../../types/ui";
import BrandLogo from "../brand/BrandLogo.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  content?: HeroContent;
}

const { content = HERO_CONTENT } = Astro.props;
---

<section class="mb-12">
  <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-6">
      <p
        class="m-0 inline-flex max-w-full items-center gap-2 rounded-full bg-primary-soft px-3.5 py-1.5 text-xs font-semibold text-primary"
      >
        <BrandLogo class="h-4 w-4 text-primary" />
        <span class="min-w-0">{content.badge}</span>
      </p>

      <h1
        class="mt-4 font-display text-3xl font-bold leading-tight text-text-primary sm:text-4xl lg:text-[2.75rem]"
      >
        {content.titleStart}{" "}
        <span class="text-primary">{content.titleHighlight}</span>
      </h1>

      <p class="mt-4 max-w-xl text-sm leading-relaxed text-text-secondary sm:text-base">
        {content.description}
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={content.primaryCta.href}
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-sos px-6 py-3 text-center text-sm font-semibold text-white no-underline shadow-xs transition-opacity hover:opacity-95"
        >
          <Icon name="sos" class="h-4 w-4" />
          <span>{content.primaryCta.label}</span>
        </a>

        <a
          href={content.secondaryCta.href}
          class="inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-full border border-border bg-bg-surface px-5 py-3 text-center text-sm font-semibold text-text-primary no-underline transition-colors hover:bg-bg-canvas"
        >
          <span
            aria-hidden="true"
            class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-secondary-soft text-secondary-text"
          >
            <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </span>
          <span>{content.secondaryCta.label}</span>
        </a>
      </div>
    </div>

    <div class="min-w-0 lg:col-span-6">
      <div class="relative mx-auto max-w-lg pt-4">
        <div
          aria-hidden="true"
          class="absolute inset-x-3 bottom-0 top-10 rounded-[2.5rem] rounded-tl-[5rem] bg-secondary-soft"
        >
        </div>
        <div
          aria-hidden="true"
          class="absolute right-0 top-4 h-36 w-36 rounded-full bg-primary-soft"
        >
        </div>
        <div aria-hidden="true" class="absolute left-1 top-2 text-primary/25">
          <BrandLogo class="h-9 w-9" />
        </div>

        <img
          src={content.image.src}
          alt={content.image.alt}
          width={content.image.width}
          height={content.image.height}
          fetchpriority="high"
          decoding="async"
          class="relative z-10 mx-auto block h-auto w-full max-w-[440px] object-contain"
        />
      </div>
    </div>
  </div>
</section>
