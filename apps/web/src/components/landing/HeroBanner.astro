---
import { HERO_CONTENT } from "../../data/landing";
import { BRAND_NAME, JURISDICTION_LABEL } from "../../data/navigation";
import type { HeroContent } from "../../types/ui";
import BrandLogo from "../brand/BrandLogo.astro";

interface Props {
  content?: HeroContent;
}

const { content = HERO_CONTENT } = Astro.props;
---

<section class="mb-8 rounded-xl border border-border bg-bg-surface p-5 shadow-xs sm:p-6 lg:p-8">
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between md:gap-8">
    <div class="min-w-0 max-w-2xl flex-1">
      <p class="m-0 inline-block rounded-lg bg-primary-soft px-3 py-1 text-xs font-semibold text-primary sm:rounded-full">
        {content.badge}
      </p>
      <h1 class="mt-3 font-display text-2xl font-bold text-text-primary lg:text-3xl">
        {content.title}
      </h1>
      <p class="mt-2.5 text-sm leading-relaxed text-text-secondary lg:text-base">
        {content.description}
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={content.primaryCta.href}
          class="inline-flex min-h-[48px] items-center justify-center rounded-lg border border-transparent bg-sos px-5 py-3 text-center text-sm font-semibold text-white no-underline transition-opacity hover:opacity-95"
        >
          {content.primaryCta.label}
        </a>
        <a
          href={content.secondaryCta.href}
          class="inline-flex min-h-[48px] items-center justify-center rounded-lg border border-border bg-bg-surface px-5 py-3 text-center text-sm font-semibold text-text-primary no-underline transition-colors hover:bg-bg-canvas"
        >
          {content.secondaryCta.label}
        </a>
      </div>
    </div>

    <div
      aria-hidden="true"
      class="hidden shrink-0 flex-col items-center justify-center rounded-2xl border border-border bg-primary-soft px-7 py-6 text-center md:flex"
    >
      <BrandLogo class="h-20 w-20 text-primary" />
      <span class="mt-3 font-display text-sm font-bold text-text-primary">{BRAND_NAME}</span>
      <span class="mt-0.5 text-xs font-medium text-text-secondary">{JURISDICTION_LABEL}</span>
    </div>
  </div>
</section>
