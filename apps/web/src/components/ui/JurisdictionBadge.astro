---
import { JURISDICTION_LABEL } from "../../data/navigation";

interface Props {
  label?: string;
  size?: "sm" | "md";
  class?: string;
}

const { label = JURISDICTION_LABEL, size = "sm", class: className } = Astro.props;

const paddingClass = size === "md" ? "px-3 py-1 font-semibold" : "px-2.5 py-1 font-medium";
---

<span
  class:list={[
    "inline-flex items-center rounded-full bg-primary-soft text-xs text-primary",
    paddingClass,
    className,
  ]}
>
  {label}
</span>
