---
import BaseHead from "../components/layout/BaseHead.astro";
import DesktopNavbar from "../components/layout/DesktopNavbar.astro";
import MobileBottomNav from "../components/layout/MobileBottomNav.astro";
import MobileHeader from "../components/layout/MobileHeader.astro";
import WebFooter from "../components/layout/WebFooter.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Plataforma ciudadana de orientación jurídica, atención veterinaria y denuncia contra el maltrato animal en Sucre, Bolivia.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
  <BaseHead title={title} description={description}>
    <slot name="head" />
  </BaseHead>
  <body class="flex min-h-dvh flex-col bg-bg-canvas text-text-primary antialiased">
    <a href="#main-content" class="skip-link visually-hidden">
      Saltar al contenido principal
    </a>

    <MobileHeader />
    <DesktopNavbar currentPath={currentPath} />

    <main
      id="main-content"
      class="flex-1 pt-[calc(3.5rem+env(safe-area-inset-top,0px))] pb-[calc(6rem+env(safe-area-inset-bottom,0px))] lg:pt-0 lg:pb-12"
    >
      <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <slot />
      </div>
    </main>

    <WebFooter />
    <MobileBottomNav currentPath={currentPath} />

    <script>
      const skipLink = document.querySelector<HTMLAnchorElement>(".skip-link");
      skipLink?.addEventListener("click", (event) => {
        const heading = document.querySelector<HTMLElement>("#main-content h1");
        const fallback = document.getElementById("main-content");
        const target = heading ?? fallback;
        if (!target) {
          return;
        }
        event.preventDefault();
        if (!target.hasAttribute("tabindex")) {
          target.setAttribute("tabindex", "-1");
          target.addEventListener(
            "blur",
            () => {
              target.removeAttribute("tabindex");
            },
            { once: true },
          );
        }
        target.scrollIntoView({ block: "start" });
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
