# Aplicación
ENVIRONMENT=development

# PostgreSQL 16
POSTGRES_USER=sos_animal
POSTGRES_PASSWORD=sos_animal_dev_password
POSTGRES_DB=sos_animal_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sos_animal:sos_animal_dev_password@localhost:5432/sos_animal_db

# MinIO (Compatible S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_EVIDENCES=sos-evidences
MINIO_BUCKET_DOCUMENTS=sos-documents
MINIO_USE_SSL=false
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:4321

# Seguridad FastAPI (JWT)
SECRET_KEY=change-this-super-secret-jwt-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:4321"]

# Frontend Astro
PUBLIC_API_URL=http://localhost:8000/api/v1
